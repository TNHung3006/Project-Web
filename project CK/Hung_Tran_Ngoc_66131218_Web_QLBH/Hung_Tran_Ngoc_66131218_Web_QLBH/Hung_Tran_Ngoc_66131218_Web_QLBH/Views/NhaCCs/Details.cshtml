@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.NhaCC

@{
    ViewData["Title"] = "Chi tiết nhà cung cấp";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow-lg border-0 overflow-hidden">
                <div class="card-header bg-info bg-gradient text-white p-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-building me-2"></i>HỒ SƠ NHÀ CUNG CẤP</h5>
                    <span class="badge bg-white text-info shadow-sm">Mã: @Model.MaNCC</span>
                </div>

                <div class="card-body p-0">
                    <div class="row g-0">
                        <div class="col-md-4 bg-light d-flex flex-column align-items-center justify-content-center p-4 border-end">
                            <div class="mb-3">
                                <div class="rounded-circle bg-white shadow d-flex align-items-center justify-content-center text-secondary" style="width: 120px; height: 120px;">
                                    <i class="fas fa-truck fa-3x opacity-25"></i>
                                </div>
                            </div>
                            <h5 class="fw-bold text-dark text-center mb-1">@Model.TenNCC</h5>
                            <span class="badge bg-secondary rounded-pill">Đối tác tin cậy</span>
                        </div>

                        <div class="col-md-8 p-4">
                            <h6 class="text-muted fw-bold text-uppercase small border-bottom pb-2 mb-3">Thông tin liên hệ</h6>
                            <div class="row mb-3">
                                <div class="col-md-4 text-secondary"><i class="fas fa-phone-alt me-2"></i>Điện thoại:</div>
                                <div class="col-md-8 fw-bold">@Html.DisplayFor(model => model.DienThoaiNCC)</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-md-4 text-secondary"><i class="fas fa-envelope me-2"></i>Email:</div>
                                <div class="col-md-8 text-primary">@Html.DisplayFor(model => model.EmailNCC)</div>
                            </div>

                            <h6 class="text-muted fw-bold text-uppercase small border-bottom pb-2 mb-3">Địa chỉ kho hàng</h6>
                            <div class="row mb-2">
                                <div class="col-md-4 text-secondary">Chi tiết:</div>
                                <div class="col-md-8">@Html.DisplayFor(model => model.DiaChiNCC)</div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 text-secondary">Địa chỉ đầy đủ:</div>
                                <div class="col-md-8 fst-italic">
                                    <i class="fas fa-map-marker-alt me-1 text-danger"></i> @Html.DisplayFor(model => model.DiaChiNCCFull)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white p-3 d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.MaNCC" class="btn btn-warning px-4 shadow-sm fw-bold">
                        <i class="fas fa-edit me-1"></i> Cập nhật
                    </a>
                    <a asp-action="Index" class="btn btn-secondary px-4 shadow-sm">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>