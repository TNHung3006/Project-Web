@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.NhomSP

@{
    ViewData["Title"] = "Chi tiết nhóm SP";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-info bg-gradient text-white p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-info-circle me-2"></i>THÔNG TIN CHI TIẾT</h5>
                </div>

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="avatar bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-boxes fa-2x text-info"></i>
                        </div>
                        <h4 class="fw-bold text-dark">@Model.TenNhomSP</h4>
                        <span class="badge bg-secondary">Mã Nhóm: @Model.MaNhomSP</span>
                    </div>

                    <div class="alert alert-light border text-center text-muted small">
                        Nhóm sản phẩm là cấp phân loại cao nhất, chứa các loại sản phẩm con.
                    </div>
                </div>

                <div class="card-footer bg-white p-3 d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.MaNhomSP" class="btn btn-warning px-4 shadow-sm fw-bold">
                        <i class="fas fa-edit me-1"></i> Sửa
                    </a>
                    <a asp-action="Index" class="btn btn-secondary px-4 shadow-sm">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>