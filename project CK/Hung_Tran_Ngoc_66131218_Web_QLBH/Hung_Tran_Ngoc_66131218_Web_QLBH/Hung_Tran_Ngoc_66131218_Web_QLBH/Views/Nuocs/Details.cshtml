@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.Nuoc

@{
    ViewData["Title"] = "Chi tiết quốc gia";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-info bg-gradient text-white p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-info-circle me-2"></i>THÔNG TIN CHI TIẾT</h5>
                </div>

                <div class="card-body p-4 text-center">
                    <div class="mb-4">
                        <div class="avatar bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-flag fa-2x text-danger"></i>
                        </div>
                        <h3 class="fw-bold text-dark">@Model.TenNuoc</h3>
                        <span class="badge bg-secondary fs-6 px-3 py-2">Mã: @Model.MaNuoc</span>
                    </div>
                </div>

                <div class="card-footer bg-white p-3 d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.MaNuoc" class="btn btn-warning px-4 shadow-sm fw-bold">
                        <i class="fas fa-edit me-1"></i> Sửa
                    </a>
                    <a asp-action="Index" class="btn btn-secondary px-4 shadow-sm">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>