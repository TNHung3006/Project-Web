@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.Nuoc

@{
    ViewData["Title"] = "Cập nhật quốc gia";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-warning bg-gradient text-dark p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-edit me-2"></i>CẬP NHẬT QUỐC GIA</h5>
                </div>

                <div class="card-body p-4 bg-light">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="MaNuoc" class="form-control bg-white" readonly />
                            <label asp-for="MaNuoc">Mã Quốc Gia</label>
                            <span asp-validation-for="MaNuoc" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="TenNuoc" class="form-control" placeholder="Tên nước" />
                            <label asp-for="TenNuoc">Tên Quốc Gia</label>
                            <span asp-validation-for="TenNuoc" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="fas fa-arrow-left me-1"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold shadow-sm">
                                <i class="fas fa-check-circle me-1"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}