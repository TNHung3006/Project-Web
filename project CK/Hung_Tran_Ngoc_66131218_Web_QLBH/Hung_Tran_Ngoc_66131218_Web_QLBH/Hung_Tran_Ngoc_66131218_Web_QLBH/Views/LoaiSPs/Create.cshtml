@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.LoaiSP

@{
    ViewData["Title"] = "Thêm loại sản phẩm";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-primary bg-gradient text-white p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-layer-group me-2"></i>THÊM LOẠI SẢN PHẨM</h5>
                </div>

                <div class="card-body p-4 bg-light">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-floating mb-3">
                            <select asp-for="MaNhomSP" class="form-select" asp-items="ViewBag.NhomSPs">
                                <option value="">-- Chọn Nhóm Sản Phẩm --</option>
                            </select>
                            <label asp-for="MaNhomSP">Thuộc Nhóm</label>
                            <span asp-validation-for="MaNhomSP" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="TenLSP" class="form-control" placeholder="Tên loại" />
                            <label asp-for="TenLSP">Tên Loại Sản Phẩm</label>
                            <span asp-validation-for="TenLSP" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                                <i class="fas fa-save me-1"></i> Lưu lại
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}