@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.DonMuaHang

@{
    ViewData["Title"] = "Cập nhật đơn mua";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-warning bg-gradient text-dark p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-edit me-2"></i>CẬP NHẬT ĐƠN MUA #@Model.MaDMH</h5>
                </div>

                <div class="card-body p-4 bg-light">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="MaDMH" />

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-header bg-white fw-bold text-primary border-bottom-0">
                                        <i class="fas fa-info-circle me-1"></i> Thông tin chung
                                    </div>
                                    <div class="card-body">
                                        <div class="form-floating mb-3">
                                            <input asp-for="NgayMua" type="datetime-local" class="form-control"
                                                   value="@Model.NgayMua.ToString("yyyy-MM-ddTHH:mm")" />
                                            <label asp-for="NgayMua">Ngày nhập hàng</label>
                                            <span asp-validation-for="NgayMua" class="text-danger"></span>
                                        </div>

                                        <div class="form-floating">
                                            <select asp-for="MaTTDMH" class="form-select bg-info bg-opacity-10 border-info text-dark fw-bold" asp-items="ViewBag.TTDMHs">
                                                <option value="">-- Chọn Trạng Thái --</option>
                                            </select>
                                            <label asp-for="MaTTDMH">Trạng thái</label>
                                            <span asp-validation-for="MaTTDMH" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-header bg-white fw-bold text-success border-bottom-0">
                                        <i class="fas fa-handshake me-1"></i> Thông tin liên quan
                                    </div>
                                    <div class="card-body">
                                        <div class="form-floating mb-3">
                                            <select asp-for="MaNCC" class="form-select" asp-items="ViewBag.NhaCCs">
                                                <option value="">-- Chọn Nhà Cung Cấp --</option>
                                            </select>
                                            <label asp-for="MaNCC">Nhà cung cấp</label>
                                            <span asp-validation-for="MaNCC" class="text-danger"></span>
                                        </div>

                                        <div class="form-floating">
                                            <select asp-for="MaNV" class="form-select" asp-items="ViewBag.NhanViens">
                                                <option value="">-- Chọn Nhân Viên --</option>
                                            </select>
                                            <label asp-for="MaNV">Nhân viên nhập</label>
                                            <span asp-validation-for="MaNV" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="fas fa-arrow-left me-1"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold shadow-sm">
                                <i class="fas fa-check-circle me-1"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}