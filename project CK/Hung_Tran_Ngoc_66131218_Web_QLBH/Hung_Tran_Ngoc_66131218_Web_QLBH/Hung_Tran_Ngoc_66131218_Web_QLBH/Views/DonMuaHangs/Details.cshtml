@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.DonMuaHang

@{
    ViewData["Title"] = "Chi tiết đơn mua";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-info bg-gradient text-white p-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-file-invoice-dollar me-2"></i>CHI TIẾT ĐƠN MUA #@Model.MaDMH</h5>
                    <span class="badge bg-white text-info shadow-sm">@Html.DisplayFor(model => model.NgayMua)</span>
                </div>

                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6 border-end">
                            <h6 class="text-primary fw-bold text-uppercase mb-3"><i class="fas fa-truck me-2"></i>Nhà cung cấp</h6>
                            <ul class="list-unstyled">
                                <li class="mb-2"><strong>Tên NCC:</strong> <span class="text-dark fs-5">@Html.DisplayFor(model => model.TenNCC)</span></li>
                                <li class="mb-2 text-muted small">Mã NCC: @Html.DisplayFor(model => model.MaNCC)</li>
                            </ul>
                        </div>

                        <div class="col-md-6 ps-md-4">
                            <h6 class="text-success fw-bold text-uppercase mb-3"><i class="fas fa-user-tie me-2"></i>Nhân sự & Trạng thái</h6>
                            <div class="mb-3">
                                <small class="text-muted d-block">Nhân viên thực hiện:</small>
                                <strong>@Html.DisplayFor(model => model.TenNVFull)</strong>
                                <span class="text-muted small">(@Html.DisplayFor(model => model.MaNV))</span>
                            </div>

                            <div class="p-3 bg-light rounded border border-info border-opacity-25">
                                <span class="badge bg-info text-dark fs-6 mb-1">@Html.DisplayFor(model => model.TenTTDMH)</span>
                                <small class="d-block text-muted mt-1">Mã trạng thái: @Html.DisplayFor(model => model.MaTTDMH)</small>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white p-3 d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.MaDMH" class="btn btn-warning px-4 shadow-sm fw-bold">
                        <i class="fas fa-edit me-1"></i> Cập nhật
                    </a>
                    <a asp-action="Index" class="btn btn-secondary px-4 shadow-sm">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>