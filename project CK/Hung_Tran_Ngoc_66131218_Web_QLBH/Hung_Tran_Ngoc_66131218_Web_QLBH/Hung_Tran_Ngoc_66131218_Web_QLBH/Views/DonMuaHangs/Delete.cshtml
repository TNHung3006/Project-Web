@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.DonMuaHang

@{
    ViewData["Title"] = "Xóa đơn mua";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger bg-gradient text-white p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-trash-alt me-2"></i>XÁC NHẬN XÓA ĐƠN MUA</h5>
                </div>

                <div class="card-body p-4 text-center">
                    <i class="fas fa-exclamation-circle text-danger fa-5x mb-3 opacity-75"></i>
                    <h4 class="mb-2">Bạn có chắc chắn muốn xóa?</h4>
                    <p class="text-muted mb-4">Hành động này sẽ xóa đơn mua hàng và các chi tiết liên quan.</p>

                    <div class="bg-light p-3 rounded text-start mb-4 border-start border-4 border-danger">
                        <div class="row mb-2">
                            <div class="col-4 text-muted">Mã Đơn:</div>
                            <div class="col-8 fw-bold text-dark">#@Model.MaDMH</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-4 text-muted">Ngày nhập:</div>
                            <div class="col-8">@Html.DisplayFor(model => model.NgayMua)</div>
                        </div>
                        <div class="row">
                            <div class="col-4 text-muted">Mã NCC:</div>
                            <div class="col-8 fw-bold text-primary">
                                @Html.DisplayFor(model => model.MaNCC)
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" class="d-flex justify-content-center gap-3">
                        <input type="hidden" asp-for="MaDMH" />

                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fas fa-times me-1"></i> Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">
                            <i class="fas fa-trash me-1"></i> Xóa vĩnh viễn
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>