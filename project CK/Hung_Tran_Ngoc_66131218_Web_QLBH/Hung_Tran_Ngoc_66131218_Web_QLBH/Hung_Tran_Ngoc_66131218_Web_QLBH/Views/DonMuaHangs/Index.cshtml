@model IEnumerable<Hung_Tran_Ngoc_66131218_Web_QLBH.Models.DonMuaHang>

@{
    ViewData["Title"] = "Quản lý đơn mua hàng";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container-fluid py-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary bg-gradient text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="fas fa-file-import me-2"></i>QUẢN LÝ ĐƠN MUA HÀNG</h5>
            <a asp-action="Create" class="btn btn-light btn-sm rounded-pill fw-bold text-primary shadow-sm">
                <i class="fas fa-plus me-1"></i> Nhập hàng mới
            </a>
        </div>

        <div class="card-body bg-light">
            <form asp-action="Index" method="get" class="row justify-content-end mb-3">
                <div class="col-md-4">
                    <div class="input-group shadow-sm">
                        <input type="text" name="search" value="@ViewData["CurrentFilter"]" class="form-control border-0" placeholder="Tìm theo nhà cung cấp, mã đơn..." />
                        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
                    </div>
                </div>
            </form>

            <div class="table-responsive rounded shadow-sm">
                <table class="table table-hover align-middle mb-0 bg-white">
                    <thead class="bg-light">
                        <tr class="text-uppercase text-secondary text-xs font-weight-bolder opacity-7">
                            <th class="ps-3">Đơn mua hàng</th>
                            <th>Nhà cung cấp</th>
                            <th>Nhân viên nhập</th>
                            <th>Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold text-primary">#@item.MaDMH</span>
                                        <small class="text-muted"><i class="far fa-calendar-alt me-1"></i> @item.NgayMua</small>
                                    </div>
                                </td>

                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold text-dark">
                                            <i class="fas fa-building text-secondary me-2"></i>@item.TenNCC
                                        </span>
                                        <small class="text-muted text-xs ms-4">Mã NCC: @item.MaNCC</small>
                                    </div>
                                </td>

                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="text-dark fw-bold">
                                            <i class="fas fa-user-tie text-info me-2"></i>@item.TenNVFull
                                        </span>
                                        <small class="text-muted text-xs ms-4">Mã NV: @item.MaNV</small>
                                    </div>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border border-secondary">
                                        @item.TenTTDMH
                                    </span>
                                </td>

                                <td class="text-center">
                                    <div class="btn-group shadow-sm">
                                        <a asp-action="Edit" asp-route-id="@item.MaDMH" class="btn btn-sm btn-outline-primary" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.MaDMH" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                            <i class="fas fa-info-circle"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaDMH" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>