@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.SanPham

@{
    ViewData["Title"] = "Cập nhật Sản Phẩm";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-warning bg-gradient text-dark p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-edit me-2"></i>CẬP NHẬT SẢN PHẨM</h5>
                </div>

                <div class="card-body p-4 bg-light">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="MaSP" />
                        <input type="hidden" name="existingAnh" value="@Model.AnhSP" />

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-header bg-white fw-bold text-primary border-bottom-0">
                                        <i class="fas fa-info-circle me-1"></i> Thông tin chung
                                    </div>
                                    <div class="card-body">
                                        <div class="form-floating mb-3">
                                            <input asp-for="TenSP" class="form-control" />
                                            <label asp-for="TenSP">Tên Sản Phẩm</label>
                                            <span asp-validation-for="TenSP" class="text-danger"></span>
                                        </div>

                                        <div class="row g-2 mb-3">
                                            <div class="col-md-8">
                                                <div class="form-floating">
                                                    <input asp-for="DonGia" class="form-control" />
                                                    <label asp-for="DonGia">Đơn Giá</label>
                                                    <span asp-validation-for="DonGia" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-floating">
                                                    <select asp-for="MaDVT" class="form-select" asp-items="ViewBag.DonViTinhs"></select>
                                                    <label asp-for="MaDVT">ĐVT</label>
                                                    <span asp-validation-for="MaDVT" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mb-3 p-3 bg-light rounded border border-dashed text-center">
                                            <label class="form-label fw-bold small text-muted mb-2">ẢNH SẢN PHẨM</label>
                                            <div class="d-flex align-items-center justify-content-center gap-3">
                                                @if (!string.IsNullOrEmpty(Model.AnhSP))
                                                {
                                                    <div class="position-relative">
                                                        <img src="~/images/uploads/@Model.AnhSP" class="rounded shadow-sm" style="width: 80px; height: 80px; object-fit: cover;" />
                                                        <span class="badge bg-secondary position-absolute top-100 start-50 translate-middle-x mt-1">Cũ</span>
                                                    </div>
                                                }
                                                <div class="flex-grow-1 text-start">
                                                    <input type="file" name="image" class="form-control form-control-sm" />
                                                    <small class="text-muted fst-italic d-block mt-1">Chọn ảnh mới để thay thế (nếu cần)</small>
                                                </div>
                                            </div>
                                            <span asp-validation-for="AnhSP" class="text-danger"></span>
                                        </div>

                                        <div class="form-floating">
                                            <textarea asp-for="MoTaSP" class="form-control" style="height: 100px"></textarea>
                                            <label asp-for="MoTaSP">Mô tả</label>
                                            <span asp-validation-for="MoTaSP" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm mb-3">
                                    <div class="card-header bg-white fw-bold text-success border-bottom-0">
                                        <i class="fas fa-sitemap me-1"></i> Phân loại & Xuất xứ
                                    </div>
                                    <div class="card-body bg-light rounded-bottom">
                                        <div class="mb-3">
                                            <label class="form-label small text-muted fw-bold">NHÓM SP & LOẠI SP</label>
                                            <select id="ddlNhomSP" class="form-select mb-2" asp-items="ViewBag.NhomSPs">
                                                <option value="">-- Chọn Nhóm SP --</option>
                                            </select>
                                            <select asp-for="MaLSP" class="form-select border-success" asp-items="ViewBag.LoaiSPs"></select>
                                            <span asp-validation-for="MaLSP" class="text-danger"></span>
                                        </div>
                                        <hr class="text-muted opacity-25" />

                                        <div class="mb-3">
                                            <label class="form-label small text-muted fw-bold">QUỐC GIA & HÃNG SX</label>
                                            <select id="ddlNuoc" class="form-select mb-2" asp-items="ViewBag.Nuocs">
                                                <option value="">-- Chọn Nước --</option>
                                            </select>
                                            <select asp-for="MaHSX" class="form-select border-success" asp-items="ViewBag.HangSXs"></select>
                                            <span asp-validation-for="MaHSX" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="card border-0 shadow-sm">
                                    <div class="card-body">
                                        <label asp-for="MaTT" class="form-label fw-bold text-secondary">Trạng Thái</label>
                                        <select asp-for="MaTT" class="form-select form-select-lg bg-warning bg-opacity-10 border-warning text-dark fw-bold" asp-items="ViewBag.TrangThais"></select>
                                        <span asp-validation-for="MaTT" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="fas fa-arrow-left me-1"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold shadow-sm">
                                <i class="fas fa-check-circle me-1"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // LOGIC AJAX GIỐNG CREATE (Giữ nguyên)
            $("#ddlNhomSP").change(function () {
                var nhomID = $(this).val();
                $("#MaLSP").empty().append('<option value="">-- Đang tải... --</option>');
                if (nhomID) {
                    $.ajax({
                        url: '@Url.Action("GetLoaiSPByNhom", "SanPhams")',
                        type: "GET",
                        data: { maNhomSP: nhomID },
                        success: function (data) {
                            $("#MaLSP").empty().append('<option value="">-- Chọn Loại SP --</option>');
                            $.each(data, function (i, item) {
                                $("#MaLSP").append('<option value="' + item.maLSP + '">' + item.tenLSP + '</option>');
                            });
                        }
                    });
                } else {
                    $("#MaLSP").empty();
                }
            });

            $("#ddlNuoc").change(function () {
                var nuocID = $(this).val();
                $("#MaHSX").empty().append('<option value="">-- Đang tải... --</option>');
                if (nuocID) {
                    $.ajax({
                        url: '@Url.Action("GetHangSXByNuoc", "SanPhams")',
                        type: "GET",
                        data: { maNuoc: nuocID },
                        success: function (data) {
                            $("#MaHSX").empty().append('<option value="">-- Chọn Hãng SX --</option>');
                            $.each(data, function (i, item) {
                                $("#MaHSX").append('<option value="' + item.maHSX + '">' + item.tenHSX + '</option>');
                            });
                        }
                    });
                } else {
                    $("#MaHSX").empty();
                }
            });
        });
    </script>
}