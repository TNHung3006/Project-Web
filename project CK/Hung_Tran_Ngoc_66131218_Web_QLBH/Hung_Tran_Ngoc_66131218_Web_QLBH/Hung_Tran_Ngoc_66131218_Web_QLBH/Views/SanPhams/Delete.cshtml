@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.SanPham

@{
    ViewData["Title"] = "Xóa Sản Phẩm";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger bg-gradient text-white p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>XÁC NHẬN XÓA SẢN PHẨM</h5>
                </div>

                <div class="card-body p-4 text-center">
                    <h4 class="mb-4 text-secondary">Bạn có chắc chắn muốn xóa sản phẩm này?</h4>

                    <div class="d-flex align-items-center justify-content-center mb-4 p-3 bg-light rounded border border-danger border-opacity-25">
                        @if (!string.IsNullOrEmpty(Model.AnhSP))
                        {
                            <img src="/images/uploads/@Model.AnhSP" class="rounded shadow-sm me-4" style="width: 100px; height: 100px; object-fit: cover;" />
                        }
                        <div class="text-start">
                            <h3 class="fw-bold text-dark mb-1">@Model.TenSP</h3>
                            <p class="text-danger fw-bold mb-0 fs-5">@string.Format("{0:#,##0} đ", Model.DonGia)</p>
                            <small class="text-muted">Mã SP: @Model.MaSP</small>
                        </div>
                    </div>

                    <div class="alert alert-warning border-0 small">
                        <i class="fas fa-info-circle me-1"></i> Hành động này không thể hoàn tác. Dữ liệu liên quan có thể bị ảnh hưởng.
                    </div>

                    <form asp-action="Delete" class="mt-4 d-flex justify-content-center gap-3">
                        <input type="hidden" asp-for="MaSP" />

                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fas fa-times me-1"></i> Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">
                            <i class="fas fa-trash-alt me-1"></i> Xóa vĩnh viễn
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>