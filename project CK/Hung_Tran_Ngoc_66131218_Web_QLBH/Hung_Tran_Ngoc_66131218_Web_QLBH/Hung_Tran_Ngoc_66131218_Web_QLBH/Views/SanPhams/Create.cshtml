@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.SanPham

@{
    ViewData["Title"] = "Thêm mới Sản Phẩm";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-primary bg-gradient text-white p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-plus-circle me-2"></i>THÊM MỚI SẢN PHẨM</h5>
                </div>

                <div class="card-body p-4 bg-light">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-header bg-white fw-bold text-primary border-bottom-0">
                                        <i class="fas fa-info-circle me-1"></i> Thông tin chung
                                    </div>
                                    <div class="card-body">
                                        <div class="form-floating mb-3">
                                            <input asp-for="TenSP" class="form-control" placeholder="Nhập tên sản phẩm" />
                                            <label asp-for="TenSP">Tên Sản Phẩm</label>
                                            <span asp-validation-for="TenSP" class="text-danger"></span>
                                        </div>

                                        <div class="row g-2 mb-3">
                                            <div class="col-md-8">
                                                <div class="form-floating">
                                                    <input asp-for="DonGia" class="form-control" placeholder="Giá bán" />
                                                    <label asp-for="DonGia">Đơn Giá (VNĐ)</label>
                                                    <span asp-validation-for="DonGia" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="form-floating">
                                                    <select asp-for="MaDVT" class="form-select" asp-items="ViewBag.DonViTinhs">
                                                        <option value="">-- ĐVT --</option>
                                                    </select>
                                                    <label asp-for="MaDVT">Đơn vị</label>
                                                    <span asp-validation-for="MaDVT" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="AnhSP" class="form-label fw-bold text-secondary small">ẢNH ĐẠI DIỆN</label>
                                            <input type="file" name="image" class="form-control" />
                                            <span asp-validation-for="AnhSP" class="text-danger"></span>
                                        </div>

                                        <div class="form-floating">
                                            <textarea asp-for="MoTaSP" class="form-control" style="height: 120px" placeholder="Mô tả"></textarea>
                                            <label asp-for="MoTaSP">Mô tả chi tiết</label>
                                            <span asp-validation-for="MoTaSP" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm mb-3">
                                    <div class="card-header bg-white fw-bold text-success border-bottom-0">
                                        <i class="fas fa-tags me-1"></i> Phân loại & Xuất xứ
                                    </div>
                                    <div class="card-body bg-light rounded-bottom">
                                        <div class="mb-3">
                                            <label class="form-label small text-muted fw-bold">NHÓM SẢN PHẨM</label>
                                            <select id="ddlNhomSP" class="form-select mb-2" asp-items="ViewBag.NhomSPs">
                                                <option value="">-- Chọn Nhóm --</option>
                                            </select>

                                            <select asp-for="MaLSP" class="form-select border-success" asp-items="ViewBag.LoaiSPs">
                                                <option value="">-- (Vui lòng chọn Nhóm SP trước) --</option>
                                            </select>
                                            <span asp-validation-for="MaLSP" class="text-danger"></span>
                                        </div>
                                        <hr class="text-muted opacity-25" />

                                        <div class="mb-3">
                                            <label class="form-label small text-muted fw-bold">QUỐC GIA</label>
                                            <select id="ddlNuoc" class="form-select mb-2" asp-items="ViewBag.Nuocs">
                                                <option value="">-- Chọn Quốc Gia --</option>
                                            </select>

                                            <select asp-for="MaHSX" class="form-select border-success" asp-items="ViewBag.HangSXs">
                                                <option value="">-- (Vui lòng chọn Quốc Gia trước) --</option>
                                            </select>
                                            <span asp-validation-for="MaHSX" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="card border-0 shadow-sm">
                                    <div class="card-body">
                                        <label asp-for="MaTT" class="form-label fw-bold text-secondary">Trạng Thái Kinh Doanh</label>
                                        <select asp-for="MaTT" class="form-select form-select-lg bg-warning bg-opacity-10 border-warning text-dark fw-bold" asp-items="ViewBag.TrangThais">
                                            <option value="">-- Chọn Trạng Thái --</option>
                                        </select>
                                        <span asp-validation-for="MaTT" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                                <i class="fas fa-save me-1"></i> Lưu mới
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // GIỮ NGUYÊN LOGIC AJAX CỦA BẠN
            $("#ddlNhomSP").change(function () {
                var nhomID = $(this).val();
                $("#MaLSP").empty().append('<option value="">-- Đang tải... --</option>');
                if (nhomID) {
                    $.ajax({
                        url: '@Url.Action("GetLoaiSPByNhom", "SanPhams")',
                        type: "GET",
                        data: { maNhomSP: nhomID },
                        success: function (data) {
                            $("#MaLSP").empty().append('<option value="">-- Chọn Loại SP --</option>');
                            $.each(data, function (i, item) {
                                $("#MaLSP").append('<option value="' + item.maLSP + '">' + item.tenLSP + '</option>');
                            });
                        }
                    });
                } else {
                    $("#MaLSP").empty().append('<option value="">-- Vui lòng chọn Nhóm SP trước --</option>');
                }
            });

            $("#ddlNuoc").change(function () {
                var nuocID = $(this).val();
                $("#MaHSX").empty().append('<option value="">-- Đang tải... --</option>');
                if (nuocID) {
                    $.ajax({
                        url: '@Url.Action("GetHangSXByNuoc", "SanPhams")',
                        type: "GET",
                        data: { maNuoc: nuocID },
                        success: function (data) {
                            $("#MaHSX").empty().append('<option value="">-- Chọn Hãng SX --</option>');
                            $.each(data, function (i, item) {
                                $("#MaHSX").append('<option value="' + item.maHSX + '">' + item.tenHSX + '</option>');
                            });
                        }
                    });
                } else {
                    $("#MaHSX").empty().append('<option value="">-- Vui lòng chọn Nước trước --</option>');
                }
            });
        });
    </script>
}