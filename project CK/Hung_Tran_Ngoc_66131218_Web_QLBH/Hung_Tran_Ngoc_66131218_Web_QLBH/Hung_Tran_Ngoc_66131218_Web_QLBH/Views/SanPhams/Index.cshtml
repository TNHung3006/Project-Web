@model IEnumerable<Hung_Tran_Ngoc_66131218_Web_QLBH.Models.SanPham>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container py-4">
    <div class="row align-items-center mb-4 g-3">
        <div class="col-md-4">
            <h3 class="fw-bold text-primary mb-0"><i class="fas fa-box-open me-2"></i>QUẢN LÝ SẢN PHẨM</h3>
        </div>

        <div class="col-md-8">
            <div class="d-flex justify-content-md-end justify-content-between gap-3">

                <form asp-action="Index" method="get" class="flex-grow-1 flex-md-grow-0">
                    <div class="input-group shadow-sm rounded-pill overflow-hidden">
                        <input type="text" name="search" value="@ViewData["CurrentFilter"]" class="form-control border-0 bg-white ps-3" placeholder="Tìm tên sản phẩm..." style="min-width: 250px;">
                        <button type="submit" class="btn btn-white bg-white text-primary border-start-0 pe-3">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>

                <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm fw-bold d-flex align-items-center text-nowrap">
                    <i class="fas fa-plus-circle me-1"></i> <span class="d-none d-sm-inline">Thêm SP</span>
                </a>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm hover-shadow transition-card position-relative overflow-hidden">

                    <span class="position-absolute top-0 end-0 badge bg-warning text-dark m-2 shadow-sm rounded-pill z-index-1">
                        @item.TenTT
                    </span>

                    <div class="bg-white text-center p-3 d-flex align-items-center justify-content-center position-relative" style="height: 200px;">
                        @if (!string.IsNullOrEmpty(item.AnhSP))
                        {
                            <img src="/images/uploads/@item.AnhSP" class="img-fluid transition-img" style="max-height: 100%; object-fit: contain;" alt="@item.TenSP" />
                        }
                        else
                        {
                            <div class="text-secondary d-flex flex-column align-items-center justify-content-center h-100 w-100 bg-light rounded-3">
                                <i class="fas fa-image fa-3x mb-2 opacity-50"></i>
                                <small>Chưa có ảnh</small>
                            </div>
                        }
                    </div>

                    <div class="card-body pt-2 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <small class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">
                                <i class="fas fa-industry me-1"></i>@item.HangSX
                            </small>
                            <span class="badge bg-light text-secondary border">@item.LoaiSP</span>
                        </div>

                        <h5 class="card-title fw-bold text-dark text-truncate" title="@item.TenSP">
                            @item.TenSP
                        </h5>

                        <h4 class="text-danger fw-bold my-1">
                            @string.Format("{0:#,##0} đ", item.DonGia) <small class="text-muted fs-6 fw-normal">/@item.TenDVT</small>
                        </h4>

                        <p class="card-text small text-secondary text-truncate mb-3 flex-grow-1" title="@item.MoTaSP">
                            @item.MoTaSP
                        </p>
                    </div>

                    <div class="card-footer bg-white border-top-0 p-3 pt-0">
                        <div class="d-flex justify-content-between gap-2">
                            <a asp-action="Edit" asp-route-id="@item.MaSP" class="btn btn-outline-primary btn-sm flex-fill fw-bold rounded-pill" title="Sửa">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.MaSP" class="btn btn-outline-info btn-sm flex-fill fw-bold rounded-pill" title="Chi tiết">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.MaSP" class="btn btn-outline-danger btn-sm flex-fill fw-bold rounded-pill" title="Xóa">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Hiệu ứng khi rê chuột vào thẻ */
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
    }

        /* Hiệu ứng ảnh phóng to nhẹ khi hover */
        .hover-shadow:hover .transition-img {
            transform: scale(1.05);
        }

    .transition-card {
        transition: all 0.3s cubic-bezier(.25,.8,.25,1);
    }

    .transition-img {
        transition: transform 0.3s ease;
    }

    .z-index-1 {
        z-index: 1;
    }
</style>