@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.SanPham

@{
    ViewData["Title"] = "Chi tiết Sản Phẩm";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg border-0 overflow-hidden">
                <div class="card-header bg-info bg-gradient text-white p-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-info-circle me-2"></i>CHI TIẾT SẢN PHẨM</h5>
                    <span class="badge bg-white text-info shadow-sm">Mã SP: #@Model.MaSP</span>
                </div>

                <div class="card-body p-0">
                    <div class="row g-0">
                        <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-4 border-end">
                            <div class="text-center w-100">
                                @if (!string.IsNullOrEmpty(Model.AnhSP))
                                {
                                    <img src="/images/uploads/@Model.AnhSP" class="img-fluid rounded shadow-sm mb-3 bg-white p-2" style="max-height: 300px;" alt="@Model.TenSP" />
                                }
                                else
                                {
                                    <div class="text-secondary py-5">
                                        <i class="fas fa-image fa-4x mb-2 opacity-50"></i>
                                        <p>Chưa có hình ảnh</p>
                                    </div>
                                }

                                <div class="mt-3">
                                    <h4 class="text-danger fw-bold">@string.Format("{0:#,##0} đ", Model.DonGia)</h4>
                                    <span class="badge bg-warning text-dark border border-warning">
                                        <i class="fas fa-star me-1"></i> @Html.DisplayFor(model => model.TenTT)
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-7 p-4">
                            <h3 class="fw-bold text-primary mb-3">@Model.TenSP</h3>

                            <table class="table table-borderless">
                                <tbody>
                                    <tr>
                                        <th class="text-muted w-25"><i class="fas fa-barcode me-2"></i>Mã loại:</th>
                                        <td class="fw-bold">@Model.MaLSP <span class="text-muted small">(@Html.DisplayFor(model => model.LoaiSP))</span></td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted"><i class="fas fa-industry me-2"></i>Hãng SX:</th>
                                        <td>@Model.HangSX <span class="text-muted small">(Mã: @Model.MaHSX)</span></td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted"><i class="fas fa-ruler me-2"></i>Đơn vị:</th>
                                        <td>@Model.TenDVT</td>
                                    </tr>
                                    <tr>
                                        <th class="text-muted" colspan="2"><i class="fas fa-align-left me-2"></i>Mô tả chi tiết:</th>
                                    </tr>
                                    <tr>
                                        <td colspan="2" class="bg-light rounded p-3 text-secondary fst-italic">
                                            @Html.DisplayFor(model => model.MoTaSP)
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white p-3 d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.MaSP" class="btn btn-warning px-4 shadow-sm fw-bold">
                        <i class="fas fa-edit me-1"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Index" class="btn btn-secondary px-4 shadow-sm">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>