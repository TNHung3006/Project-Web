@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.LoaiNV

@{
    ViewData["Title"] = "Xóa loại nhân viên";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger bg-gradient text-white p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-trash-alt me-2"></i>XÁC NHẬN XÓA</h5>
                </div>

                <div class="card-body p-4 text-center">
                    <i class="fas fa-exclamation-triangle text-warning fa-4x mb-3"></i>
                    <h4 class="mb-2">Bạn có chắc chắn muốn xóa?</h4>
                    <p class="text-muted mb-4">Loại nhân viên này sẽ bị xóa khỏi hệ thống vĩnh viễn.</p>

                    <div class="bg-light p-3 rounded mb-4 border border-danger border-opacity-25">
                        <h3 class="fw-bold text-dark m-0">@Model.TenLNV</h3>
                        <small class="text-muted">Mã: @Model.MaLNV</small>
                    </div>

                    <form asp-action="Delete" class="d-flex justify-content-center gap-3">
                        <input type="hidden" asp-for="MaLNV" />

                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fas fa-times me-1"></i> Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">
                            <i class="fas fa-trash me-1"></i> Xóa ngay
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>