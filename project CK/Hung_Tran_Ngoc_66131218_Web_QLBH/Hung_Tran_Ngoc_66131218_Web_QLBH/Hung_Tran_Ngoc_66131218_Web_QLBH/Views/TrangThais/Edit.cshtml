@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.TrangThai

@{
    ViewData["Title"] = "Cập nhật trạng thái";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-warning bg-gradient text-dark p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-edit me-2"></i>CẬP NHẬT TRẠNG THÁI</h5>
                </div>

                <div class="card-body p-4 bg-light">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="MaTT" />

                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">MÃ TRẠNG THÁI</label>
                            <input type="text" class="form-control bg-white" value="#@Model.MaTT" readonly disabled />
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="TenTT" class="form-control" placeholder="Tên trạng thái" />
                            <label asp-for="TenTT">Tên Trạng Thái</label>
                            <span asp-validation-for="TenTT" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="fas fa-arrow-left me-1"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold shadow-sm">
                                <i class="fas fa-check-circle me-1"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}