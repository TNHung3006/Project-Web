@model IEnumerable<Hung_Tran_Ngoc_66131218_Web_QLBH.Models.CTBH>

@{
    ViewData["Title"] = "Chi Tiết Bán Hàng";

    // 1. Gom nhóm danh sách
    var danhSachDonHang = Model.GroupBy(x => x.MaDBH).OrderByDescending(g => g.Key);

    // 2. [MỚI] Lấy Dictionary tổng tiền từ Controller gửi sang thông qua ViewBag
    var mapTongTien = ViewBag.TongTienMap as Dictionary<int, decimal>;
}

<div class="container-fluid p-4">
    <h1 class="mb-4">Chi Tiết Bán Hàng</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa fa-plus"></i> Tạo mới
        </a>
    </p>

    <div class="table-responsive">
        <table class="table table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th style="width: 5%">STT</th>
                    <th style="width: 35%">Tên sản phẩm</th>
                    <th style="width: 15%" class="text-end">Đơn giá</th>
                    <th style="width: 10%" class="text-center">Số lượng</th>
                    <th style="width: 20%" class="text-end">Thành tiền</th>
                    <th style="width: 15%" class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var donHang in danhSachDonHang)
                {
                    // Lấy thông tin dòng đầu tiên để hiển thị ngày tháng
                    var infoDonHang = donHang.First();

                    // --- [SỬA ĐOẠN NÀY] ---
                    // CŨ: var tongTienDonHang = infoDonHang.TongTienDonHang;

                    // MỚI: Tra cứu tổng tiền trong Dictionary dựa vào Mã Đơn Hàng (Key)
                    decimal tongTienDonHang = 0;
                    if (mapTongTien != null && mapTongTien.ContainsKey(donHang.Key))
                    {
                        tongTienDonHang = mapTongTien[donHang.Key];
                    }
                    // -----------------------

                    <tr class="table-secondary">
                        <td colspan="4" class="align-middle">
                            <strong>
                                <i class="fa fa-file-invoice"></i> Đơn hàng #@donHang.Key
                            </strong>
                            <span class="text-muted ms-2">
                                - Ngày bán: @infoDonHang.NgayBan.ToString("dd/MM/yyyy")
                            </span>
                        </td>
                        <td class="text-end align-middle fw-bold text-danger">
                            @tongTienDonHang.ToString("N0") ₫
                        </td>
                        <td class="text-center">
                        </td>
                    </tr>

                    var stt = 1;
                    foreach (var item in donHang)
                    {
                        <tr>
                            <td class="text-center text-muted">@stt</td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TenSP)
                            </td>
                            <td class="text-end">
                                @item.DGB.ToString("N0")
                            </td>
                            <td class="text-center">
                                @Html.DisplayFor(modelItem => item.SLB)
                            </td>
                            <td class="text-end fw-bold">
                                @item.ThanhTien.ToString("N0")
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-maDBH="@item.MaDBH" asp-route-maSP="@item.MaSP" class="btn btn-sm btn-outline-warning">Edit</a>
                                <a asp-action="Details" asp-route-maDBH="@item.MaDBH" asp-route-maSP="@item.MaSP" class="btn btn-sm btn-outline-success">Details</a>
                                <a asp-action="Delete" asp-route-maDBH="@item.MaDBH" asp-route-maSP="@item.MaSP" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                        stt++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>