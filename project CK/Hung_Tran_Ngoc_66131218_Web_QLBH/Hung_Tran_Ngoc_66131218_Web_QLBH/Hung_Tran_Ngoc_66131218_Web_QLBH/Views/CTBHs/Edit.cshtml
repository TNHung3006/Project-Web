@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.CTBH

@{
    ViewData["Title"] = "Cập nhật chi tiết";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-warning bg-gradient text-dark p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-edit me-2"></i>CẬP NHẬT CHI TIẾT BÁN HÀNG</h5>
                </div>

                <div class="card-body p-4 bg-light">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="MaDBH" />
                        <input type="hidden" asp-for="MaSP" />

                        <div class="alert alert-info border-0 d-flex align-items-center mb-4">
                            <i class="fas fa-info-circle fa-2x me-3"></i>
                            <div>
                                <small class="d-block text-uppercase fw-bold opacity-75">Thông tin định danh</small>
                                <strong>Đơn hàng:</strong> @Model.MaDBH &nbsp;|&nbsp; <strong>Mã SP:</strong> @Model.MaSP
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="SLB" class="form-control" placeholder="Số lượng" />
                                    <label asp-for="SLB">Số Lượng Bán</label>
                                    <span asp-validation-for="SLB" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="DGB" class="form-control" placeholder="Đơn giá" />
                                    <label asp-for="DGB">Đơn Giá Bán</label>
                                    <span asp-validation-for="DGB" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="fas fa-arrow-left me-1"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold shadow-sm">
                                <i class="fas fa-check-circle me-1"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}