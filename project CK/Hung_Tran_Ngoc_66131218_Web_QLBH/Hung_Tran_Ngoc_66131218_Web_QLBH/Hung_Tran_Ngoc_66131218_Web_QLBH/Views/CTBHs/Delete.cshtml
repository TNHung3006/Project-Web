@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.CTBH

@{
    ViewData["Title"] = "Xóa chi tiết";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger bg-gradient text-white p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-trash-alt me-2"></i>XÁC NHẬN XÓA</h5>
                </div>

                <div class="card-body p-4 text-center">
                    <i class="fas fa-exclamation-triangle text-warning fa-4x mb-3"></i>
                    <h4 class="mb-2">Bạn có chắc chắn muốn xóa?</h4>
                    <p class="text-muted mb-4">Dòng chi tiết bán hàng này sẽ bị xóa vĩnh viễn.</p>

                    <div class="bg-light p-3 rounded text-start mb-4 border-start border-4 border-danger">
                        <p class="mb-1"><strong>Đơn hàng:</strong> @Model.MaDBH</p>
                        <p class="mb-1"><strong>Sản phẩm:</strong> @Model.MaSP</p>
                        <p class="mb-0"><strong>Số lượng:</strong> @Model.SLB</p>
                    </div>

                    <form asp-action="Delete" class="d-flex justify-content-center gap-3">
                        <input type="hidden" asp-for="MaDBH" />
                        <input type="hidden" asp-for="MaSP" />

                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fas fa-times me-1"></i> Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">
                            <i class="fas fa-trash me-1"></i> Xóa ngay
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>