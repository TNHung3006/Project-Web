@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.NhanVien

@{
    ViewData["Title"] = "Xóa nhân viên";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger bg-gradient text-white p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-user-times me-2"></i>XÁC NHẬN XÓA NHÂN VIÊN</h5>
                </div>

                <div class="card-body p-4 text-center">
                    <div class="mb-4">
                        <i class="fas fa-user-slash text-danger fa-5x opacity-50"></i>
                    </div>

                    <h4 class="mb-2 fw-bold">@Model.HoNV @Model.TenNV</h4>
                    <p class="text-muted mb-4">Bạn có chắc chắn muốn xóa nhân viên này?</p>

                    <div class="bg-light p-3 rounded text-start mb-4 border-start border-4 border-danger">
                        <div class="row mb-2">
                            <div class="col-4 text-muted">Tài khoản:</div>
                            <div class="col-8 fw-bold">@Html.DisplayFor(model => model.TenDN)</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-4 text-muted">Chức vụ (Mã):</div>
                            <div class="col-8">@Html.DisplayFor(model => model.MaLNV)</div>
                        </div>
                        <div class="row">
                            <div class="col-4 text-muted">Email:</div>
                            <div class="col-8 text-primary">
                                @Html.DisplayFor(model => model.Email)
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning border-0 small">
                        <i class="fas fa-exclamation-triangle me-1"></i> Lưu ý: Các đơn nhập hàng do nhân viên này phụ trách có thể bị ảnh hưởng.
                    </div>

                    <form asp-action="Delete" class="d-flex justify-content-center gap-3">
                        <input type="hidden" asp-for="MaNV" />

                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fas fa-times me-1"></i> Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">
                            <i class="fas fa-trash me-1"></i> Xóa vĩnh viễn
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>