@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.NhanVien

@{
    ViewData["Title"] = "Chi tiết nhân viên";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow-lg border-0 overflow-hidden">
                <div class="card-header bg-info bg-gradient text-white p-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-user-tie me-2"></i>HỒ SƠ NHÂN VIÊN</h5>
                    <span class="badge bg-white text-info shadow-sm">Mã NV: @Model.MaNV</span>
                </div>

                <div class="card-body p-0">
                    <div class="row g-0">
                        <div class="col-md-4 bg-light d-flex flex-column align-items-center justify-content-center p-4 border-end">
                            <div class="mb-3">
                                <div class="rounded-circle bg-white shadow d-flex align-items-center justify-content-center text-secondary" style="width: 120px; height: 120px;">
                                    <i class="fas fa-user fa-4x opacity-25"></i>
                                </div>
                            </div>
                            <h4 class="fw-bold text-dark text-center mb-1">@Model.HoNV @Model.TenNV</h4>
                            <span class="badge bg-primary rounded-pill mb-2">@Html.DisplayFor(model => model.TenLNV)</span>
                            <div class="text-muted small"><i class="fas fa-phone me-1"></i> @Model.DienThoai</div>
                        </div>

                        <div class="col-md-8 p-4">
                            <h6 class="text-muted fw-bold text-uppercase small border-bottom pb-2 mb-3">Thông tin tài khoản</h6>
                            <div class="row mb-3">
                                <div class="col-md-4 text-secondary">Tên đăng nhập:</div>
                                <div class="col-md-8 fw-bold">@Html.DisplayFor(model => model.TenDN)</div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-4 text-secondary">Mật khẩu:</div>
                                <div class="col-md-8 fw-bold">@Html.DisplayFor(model => model.MatKhau)</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-md-4 text-secondary">Email:</div>
                                <div class="col-md-8 text-primary">@Html.DisplayFor(model => model.Email)</div>
                            </div>

                            <h6 class="text-muted fw-bold text-uppercase small border-bottom pb-2 mb-3">Thông tin cá nhân & Địa chỉ</h6>
                            <div class="row mb-2">
                                <div class="col-md-4 text-secondary">Giới tính:</div>
                                <div class="col-md-8">@Html.DisplayFor(model => model.GioiTinh)</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-md-4 text-secondary">Xã / Phường:</div>
                                <div class="col-md-8">
                                    <span class="badge bg-light text-dark border">Mã: @Html.DisplayFor(model => model.MaXa)</span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 text-secondary">Địa chỉ:</div>
                                <div class="col-md-8 fst-italic">
                                    <i class="fas fa-map-marker-alt me-1 text-danger"></i> @Html.DisplayFor(model => model.DiaChiFull)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white p-3 d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.MaNV" class="btn btn-warning px-4 shadow-sm fw-bold">
                        <i class="fas fa-edit me-1"></i> Cập nhật
                    </a>
                    <a asp-action="Index" class="btn btn-secondary px-4 shadow-sm">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>