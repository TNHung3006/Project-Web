@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.HangSX

@{
    ViewData["Title"] = "Chi tiết Hãng SX";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-info bg-gradient text-white p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-info-circle me-2"></i>THÔNG TIN CHI TIẾT</h5>
                </div>

                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="avatar bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-industry fa-2x text-info"></i>
                        </div>
                        <h4 class="fw-bold text-dark">@Model.TenHSX</h4>
                        <span class="badge bg-secondary">Mã: @Model.MaHSX</span>
                    </div>

                    <div class="bg-light p-3 rounded border border-info border-opacity-25">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted fw-bold"><i class="fas fa-globe-asia me-2"></i>Quốc gia:</span>
                            <span class="fw-bold text-primary">
                                @Html.DisplayFor(model => model.TenNuoc)
                                <small class="text-muted fw-normal">(@Model.MaNuoc)</small>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white p-3 d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.MaHSX" class="btn btn-warning px-4 shadow-sm fw-bold">
                        <i class="fas fa-edit me-1"></i> Sửa
                    </a>
                    <a asp-action="Index" class="btn btn-secondary px-4 shadow-sm">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>