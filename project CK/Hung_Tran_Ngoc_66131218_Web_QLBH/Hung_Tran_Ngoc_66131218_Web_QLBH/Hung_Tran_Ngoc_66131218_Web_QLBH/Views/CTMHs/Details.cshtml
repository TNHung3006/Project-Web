@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.CTMH

@{
    ViewData["Title"] = "Chi tiết mua hàng";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-info bg-gradient text-white p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-info-circle me-2"></i>CHI TIẾT GIAO DỊCH NHẬP KHO</h5>
                </div>

                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6 border-end">
                            <h6 class="text-primary fw-bold text-uppercase mb-3">Thông tin đơn hàng</h6>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span class="text-muted">Mã Đơn Mua:</span>
                                    <span class="fw-bold text-dark">@Model.MaDMH</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span class="text-muted">Ngày Nhập:</span>
                                    <span class="fw-bold text-dark">@Html.DisplayFor(model => model.NgayMua)</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span class="text-muted">Sản Phẩm:</span>
                                    <span class="fw-bold text-primary">@Model.TenSP</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span class="text-muted">Mã SP:</span>
                                    <span>@Model.MaSP</span>
                                </li>
                            </ul>
                        </div>

                        <div class="col-md-6 ps-md-4">
                            <h6 class="text-success fw-bold text-uppercase mb-3">Chi tiết thanh toán</h6>
                            <div class="bg-light p-3 rounded text-center mb-3">
                                <small class="text-muted d-block">Đơn giá nhập</small>
                                <span class="fs-5 fw-bold text-dark">@string.Format("{0:#,##0} đ", Model.DGM)</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Số lượng:</span>
                                <span class="badge bg-secondary rounded-pill fs-6">x @Model.SLM</span>
                            </div>
                            <hr />
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold">THÀNH TIỀN:</span>
                                <span class="text-danger fw-bold fs-4">
                                    @Html.DisplayFor(model => model.ThanhTien)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white p-3 d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.MaDMH" class="btn btn-warning shadow-sm">
                        <i class="fas fa-edit me-1"></i> Sửa
                    </a>
                    <a asp-action="Index" class="btn btn-secondary shadow-sm">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>