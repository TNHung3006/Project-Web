@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.CTMH

@{
    ViewData["Title"] = "Thêm chi tiết mua hàng";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-primary bg-gradient text-white p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-cart-arrow-down me-2"></i>THÊM CHI TIẾT MUA HÀNG</h5>
                </div>

                <div class="card-body p-4 bg-light">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="MaDMH" class="form-select" asp-items="ViewBag.DonMuaHangs">
                                        <option value="">-- Chọn Đơn Mua Hàng --</option>
                                    </select>
                                    <label asp-for="MaDMH">Mã Đơn Mua Hàng</label>
                                    <span asp-validation-for="MaDMH" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="MaSP" class="form-select" asp-items="ViewBag.SanPhams">
                                        <option value="">-- Chọn Sản Phẩm --</option>
                                    </select>
                                    <label asp-for="MaSP">Sản Phẩm</label>
                                    <span asp-validation-for="MaSP" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="SLM" class="form-control" placeholder="Số lượng mua" />
                                    <label asp-for="SLM">Số lượng mua</label>
                                    <span asp-validation-for="SLM" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="DGM" class="form-control" placeholder="Đơn giá mua" />
                                    <label asp-for="DGM">Đơn giá mua (VNĐ)</label>
                                    <span asp-validation-for="DGM" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                                <i class="fas fa-save me-1"></i> Lưu lại
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}