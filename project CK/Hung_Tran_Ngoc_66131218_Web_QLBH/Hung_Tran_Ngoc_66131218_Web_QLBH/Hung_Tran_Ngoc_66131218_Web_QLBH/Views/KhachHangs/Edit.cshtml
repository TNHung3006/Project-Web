@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.KhachHang

@{
    ViewData["Title"] = "Cập nhật khách hàng";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-warning bg-gradient text-dark p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-user-edit me-2"></i>CẬP NHẬT THÔNG TIN KHÁCH HÀNG</h5>
                </div>

                <div class="card-body p-4 bg-light">
                    <form asp-action="Edit" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="MaKH" />
                        <input type="hidden" name="existingAnh" value="@Model.AnhKH" />

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-header bg-white fw-bold text-primary border-bottom-0">
                                        <i class="fas fa-id-card me-1"></i> Thông tin cá nhân
                                    </div>
                                    <div class="card-body">
                                        <div class="row g-2 mb-3">
                                            <div class="col-md-6">
                                                <div class="form-floating">
                                                    <input asp-for="HoKH" class="form-control" />
                                                    <label asp-for="HoKH">Họ đệm</label>
                                                    <span asp-validation-for="HoKH" class="text-danger"></span>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-floating">
                                                    <input asp-for="TenKH" class="form-control" />
                                                    <label asp-for="TenKH">Tên</label>
                                                    <span asp-validation-for="TenKH" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-floating mb-3">
                                            <input asp-for="SDT" class="form-control" />
                                            <label asp-for="SDT">Số điện thoại</label>
                                            <span asp-validation-for="SDT" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3 p-3 bg-light rounded border border-dashed text-center">
                                            <label class="form-label fw-bold small text-muted mb-2">ẢNH ĐẠI DIỆN</label>
                                            <div class="d-flex align-items-center justify-content-center gap-3">
                                                @if (!string.IsNullOrEmpty(Model.AnhKH))
                                                {
                                                    <div class="position-relative">
                                                        <img src="/images/uploads/@Model.AnhKH" class="rounded-circle shadow-sm" style="width: 80px; height: 80px; object-fit: cover;" />
                                                    </div>
                                                }
                                                <div class="flex-grow-1 text-start">
                                                    <input type="file" name="image" class="form-control form-control-sm" />
                                                    <small class="text-muted fst-italic d-block mt-1">Chọn ảnh mới để thay thế</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card border-0 shadow-sm mb-3">
                                    <div class="card-header bg-white fw-bold text-success border-bottom-0">
                                        <i class="fas fa-key me-1"></i> Tài khoản
                                    </div>
                                    <div class="card-body bg-light rounded-bottom">
                                        <div class="form-floating mb-3">
                                            <input asp-for="TenDN" class="form-control" />
                                            <label asp-for="TenDN">Tên đăng nhập</label>
                                            <span asp-validation-for="TenDN" class="text-danger"></span>
                                        </div>
                                        <div class="form-floating">
                                            <input asp-for="MatKhau" type="text" class="form-control" />
                                            <label asp-for="MatKhau">Mật khẩu</label>
                                            <span asp-validation-for="MatKhau" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="card border-0 shadow-sm">
                                    <div class="card-header bg-white fw-bold text-info border-bottom-0">
                                        <i class="fas fa-map-marked-alt me-1"></i> Địa chỉ
                                    </div>
                                    <div class="card-body">
                                        <div class="form-floating mb-3">
                                            <input asp-for="DiaChi" class="form-control" />
                                            <label asp-for="DiaChi">Địa chỉ cụ thể</label>
                                            <span asp-validation-for="DiaChi" class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label small text-muted fw-bold">TỈNH / THÀNH PHỐ</label>
                                            <select id="ddlTinh" class="form-select mb-2" asp-items="ViewBag.Tinhs">
                                                <option value="">-- Chọn Tỉnh / Thành phố --</option>
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="MaXa" class="form-label small text-muted fw-bold">XÃ / PHƯỜNG</label>
                                            <select id="ddlXa" asp-for="MaXa" class="form-select border-info" asp-items="ViewBag.Xas">
                                                <option value="">-- Chọn Tỉnh trước --</option>
                                            </select>
                                            <span asp-validation-for="MaXa" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="fas fa-arrow-left me-1"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold shadow-sm">
                                <i class="fas fa-check-circle me-1"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#ddlTinh").change(function () {
                var maTinh = $(this).val();
                $("#ddlXa").empty();

                if (maTinh) {
                    $("#ddlXa").append('<option value="">Đang tải...</option>');
                    $.ajax({
                        url: '/KhachHangs/GetXaByTinh',
                        type: 'GET',
                        data: { maTinh: maTinh },
                        success: function (data) {
                            $("#ddlXa").empty();
                            $("#ddlXa").append('<option value="">-- Chọn Xã / Phường --</option>');
                            $.each(data, function (i, item) {
                                $("#ddlXa").append('<option value="' + item.maXa + '">' + item.tenXa + '</option>');
                            });
                        },
                        error: function () {
                            alert("Lỗi tải danh sách xã.");
                            $("#ddlXa").empty();
                        }
                    });
                } else {
                    $("#ddlXa").append('<option value="">-- Chọn Tỉnh trước --</option>');
                }
            });
        });
    </script>
}