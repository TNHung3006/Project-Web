@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.KhachHang

@{
    ViewData["Title"] = "Chi tiết khách hàng";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow-lg border-0 overflow-hidden">
                <div class="card-header bg-info bg-gradient text-white p-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-user-circle me-2"></i>HỒ SƠ KHÁCH HÀNG</h5>
                    <span class="badge bg-white text-info shadow-sm">Mã KH: @Model.MaKH</span>
                </div>

                <div class="card-body p-0">
                    <div class="row g-0">
                        <div class="col-md-4 bg-light d-flex flex-column align-items-center justify-content-center p-4 border-end">
                            <div class="mb-3">
                                @if (!string.IsNullOrEmpty(Model.AnhKH))
                                {
                                    <img src="/images/uploads/@Model.AnhKH" class="rounded-circle shadow border border-3 border-white" style="width: 150px; height: 150px; object-fit: cover;" alt="Avatar" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-white shadow d-flex align-items-center justify-content-center text-secondary" style="width: 150px; height: 150px;">
                                        <i class="fas fa-user fa-4x opacity-25"></i>
                                    </div>
                                }
                            </div>
                            <h4 class="fw-bold text-dark text-center mb-1">@Model.HoKH @Model.TenKH</h4>
                            <span class="badge bg-primary rounded-pill"><i class="fas fa-phone me-1"></i> @Model.SDT</span>
                        </div>

                        <div class="col-md-8 p-4">
                            <h6 class="text-muted fw-bold text-uppercase small border-bottom pb-2 mb-3">Thông tin tài khoản</h6>
                            <div class="row mb-3">
                                <div class="col-md-4 text-secondary">Tên đăng nhập:</div>
                                <div class="col-md-8 fw-bold">@Html.DisplayFor(model => model.TenDN)</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-md-4 text-secondary">Mật khẩu:</div>
                                <div class="col-md-8 text-muted">@Model.MatKhau</div>
                            </div>

                            <h6 class="text-muted fw-bold text-uppercase small border-bottom pb-2 mb-3">Địa chỉ liên hệ</h6>
                            <div class="row mb-2">
                                <div class="col-md-4 text-secondary">Địa chỉ:</div>
                                <div class="col-md-8">@Html.DisplayFor(model => model.DiaChi)</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-md-4 text-secondary">Xã / Phường:</div>
                                <div class="col-md-8">
                                    <span class="badge bg-light text-dark border">Mã: @Html.DisplayFor(model => model.MaXa)</span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 text-secondary">Địa chỉ đầy đủ:</div>
                                <div class="col-md-8 fst-italic text-primary">
                                    <i class="fas fa-map-marker-alt me-1"></i> @Html.DisplayFor(model => model.DiaChiFull)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white p-3 d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.MaKH" class="btn btn-warning px-4 shadow-sm fw-bold">
                        <i class="fas fa-edit me-1"></i> Cập nhật
                    </a>
                    <a asp-action="Index" class="btn btn-secondary px-4 shadow-sm">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>