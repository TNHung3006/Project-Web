@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.KhachHang

@{
    ViewData["Title"] = "Xóa khách hàng";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger bg-gradient text-white p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-user-times me-2"></i>XÁC NHẬN XÓA KHÁCH HÀNG</h5>
                </div>

                <div class="card-body p-4 text-center">
                    <div class="mb-4">
                        @if (!string.IsNullOrEmpty(Model.AnhKH))
                        {
                            <img src="/images/uploads/@Model.AnhKH" class="rounded-circle shadow-sm border border-danger border-2" style="width: 100px; height: 100px; object-fit: cover;" />
                        }
                        else
                        {
                            <i class="fas fa-user-circle text-secondary fa-5x mb-2 opacity-50"></i>
                        }
                    </div>

                    <h4 class="mb-2 fw-bold">@Model.HoKH @Model.TenKH</h4>
                    <p class="text-muted mb-4">Bạn có chắc chắn muốn xóa khách hàng này khỏi hệ thống?</p>

                    <div class="bg-light p-3 rounded text-start mb-4 border-start border-4 border-danger">
                        <div class="row mb-2">
                            <div class="col-4 text-muted">Tên đăng nhập:</div>
                            <div class="col-8 fw-bold">@Html.DisplayFor(model => model.TenDN)</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-4 text-muted">Điện thoại:</div>
                            <div class="col-8">@Html.DisplayFor(model => model.SDT)</div>
                        </div>
                        <div class="row">
                            <div class="col-4 text-muted">Địa chỉ:</div>
                            <div class="col-8 small">
                                @Html.DisplayFor(model => model.DiaChiFull)
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" class="d-flex justify-content-center gap-3">
                        <input type="hidden" asp-for="MaKH" />

                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fas fa-times me-1"></i> Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">
                            <i class="fas fa-trash me-1"></i> Xóa vĩnh viễn
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>