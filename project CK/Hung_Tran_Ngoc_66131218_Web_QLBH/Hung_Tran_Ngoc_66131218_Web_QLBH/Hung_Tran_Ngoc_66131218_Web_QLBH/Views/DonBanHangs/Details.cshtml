@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.DonBanHang

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-info bg-gradient text-white p-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-file-invoice me-2"></i>CHI TIẾT ĐƠN HÀNG #@Model.MaDBH</h5>
                    <span class="badge bg-white text-info shadow-sm">@Html.DisplayFor(model => model.NgayBan)</span>
                </div>

                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6 border-end">
                            <h6 class="text-primary fw-bold text-uppercase mb-3"><i class="fas fa-user-tag me-2"></i>Khách hàng</h6>
                            <ul class="list-unstyled">
                                <li class="mb-2"><strong>Họ tên:</strong> <span class="text-dark fs-5">@Html.DisplayFor(model => model.TenKHFull)</span></li>
                                <li class="mb-2 text-muted small">Mã KH: @Html.DisplayFor(model => model.MaKH)</li>
                            </ul>
                        </div>

                        <div class="col-md-6 ps-md-4">
                            <h6 class="text-warning fw-bold text-uppercase mb-3"><i class="fas fa-tasks me-2"></i>Trạng thái đơn</h6>
                            <div class="p-3 bg-light rounded border border-warning border-opacity-25">
                                <span class="badge bg-warning text-dark fs-6 mb-1">@Html.DisplayFor(model => model.TenTTDBH)</span>
                                <small class="d-block text-muted mt-1">Mã trạng thái: @Html.DisplayFor(model => model.MaTTDBH)</small>
                            </div>
                        </div>

                        <div class="col-12"><hr class="text-muted opacity-25"></div>

                        <div class="col-12">
                            <h6 class="text-success fw-bold text-uppercase mb-3"><i class="fas fa-truck me-2"></i>Thông tin giao hàng</h6>
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted d-block">Địa chỉ:</small>
                                    <strong>@Html.DisplayFor(model => model.DiaChiGHFull)</strong>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <small class="text-muted d-block">Mã Xã/Phường:</small>
                                    <span>@Html.DisplayFor(model => model.MaXa)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white p-3 d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model?.MaDBH" class="btn btn-warning px-4 shadow-sm fw-bold">
                        <i class="fas fa-edit me-1"></i> Cập nhật
                    </a>
                    <a asp-action="Index" class="btn btn-secondary px-4 shadow-sm">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>