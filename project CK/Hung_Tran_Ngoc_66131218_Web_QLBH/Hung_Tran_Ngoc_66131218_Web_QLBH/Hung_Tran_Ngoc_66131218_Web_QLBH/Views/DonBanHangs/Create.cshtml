@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.DonBanHang

@{
    ViewData["Title"] = "Thêm đơn bán hàng";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-primary bg-gradient text-white p-3">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-file-invoice-dollar me-2"></i>TẠO ĐƠN BÁN HÀNG MỚI</h5>
                </div>

                <div class="card-body p-4 bg-light">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-header bg-white fw-bold text-primary border-bottom-0">
                                        <i class="fas fa-info-circle me-1"></i> Thông tin chung
                                    </div>
                                    <div class="card-body">
                                        <div class="form-floating mb-3">
                                            <select asp-for="MaKH" class="form-select" asp-items="ViewBag.KhachHangs">
                                                <option value="">-- Chọn Khách Hàng --</option>
                                            </select>
                                            <label asp-for="MaKH">Khách hàng</label>
                                            <span asp-validation-for="MaKH" class="text-danger"></span>
                                        </div>

                                        <div class="form-floating mb-3">
                                            <input asp-for="NgayBan" type="datetime-local" class="form-control" />
                                            <label asp-for="NgayBan">Ngày tạo đơn</label>
                                            <span asp-validation-for="NgayBan" class="text-danger"></span>
                                        </div>

                                        <div class="form-floating">
                                            <select asp-for="MaTTDBH" class="form-select bg-warning bg-opacity-10 border-warning text-dark fw-bold" asp-items="ViewBag.TrangThaiDBHs">
                                                <option value="">-- Chọn Trạng Thái --</option>
                                            </select>
                                            <label asp-for="MaTTDBH">Trạng thái đơn</label>
                                            <span asp-validation-for="MaTTDBH" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-header bg-white fw-bold text-success border-bottom-0">
                                        <i class="fas fa-shipping-fast me-1"></i> Thông tin giao hàng
                                    </div>
                                    <div class="card-body">
                                        <div class="form-floating mb-3">
                                            <input asp-for="DiaChiGH" class="form-control" placeholder="Số nhà, tên đường..." />
                                            <label asp-for="DiaChiGH">Địa chỉ giao hàng (Số nhà, đường)</label>
                                            <span asp-validation-for="DiaChiGH" class="text-danger"></span>
                                        </div>

                                        <hr class="text-muted opacity-25" />

                                        <div class="mb-3">
                                            <label class="form-label small text-muted fw-bold">TỈNH / THÀNH PHỐ</label>
                                            <select id="ddlTinh" class="form-select mb-2" asp-items="ViewBag.Tinhs">
                                                <option value="">-- Chọn Tỉnh / Thành phố --</option>
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="MaXa" class="form-label small text-muted fw-bold">XÃ / PHƯỜNG</label>
                                            <select id="ddlXa" asp-for="MaXa" class="form-select border-success" asp-items="ViewBag.Xas">
                                                <option value="">-- Vui lòng chọn Tỉnh trước --</option>
                                            </select>
                                            <span asp-validation-for="MaXa" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="fas fa-arrow-left me-1"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
                                <i class="fas fa-save me-1"></i> Lưu đơn hàng
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#ddlTinh").change(function () {
                var maTinh = $(this).val();
                $("#ddlXa").empty();

                if (maTinh) {
                    $("#ddlXa").append('<option value="">Đang tải danh sách...</option>');
                    $.ajax({
                        url: '/DonBanHangs/GetXaByTinh',
                        type: 'GET',
                        data: { maTinh: maTinh },
                        success: function (data) {
                            $("#ddlXa").empty();
                            $("#ddlXa").append('<option value="">-- Chọn Xã / Phường --</option>');
                            $.each(data, function (i, item) {
                                $("#ddlXa").append('<option value="' + item.maXa + '">' + item.tenXa + '</option>');
                            });
                        },
                        error: function () {
                            alert('Không thể tải danh sách xã/phường.');
                            $("#ddlXa").empty();
                            $("#ddlXa").append('<option value="">Lỗi tải dữ liệu</option>');
                        }
                    });
                } else {
                    $("#ddlXa").append('<option value="">-- Vui lòng chọn Tỉnh trước --</option>');
                }
            });
        });
    </script>
}