@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.SanPham

@{
    ViewData["Title"] = Model.TenSP;
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
}

<div class="container py-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.TenSP</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-5 mb-4">
            <div class="card border-0 shadow-sm">
                @if (!string.IsNullOrEmpty(Model.AnhSP))
                {
                    <img src="/images/products/@Model.AnhSP" class="card-img-top rounded" alt="@Model.TenSP">
                }
                else
                {
                    <img src="https://via.placeholder.com/500" class="card-img-top rounded" alt="No Image">
                }
            </div>
        </div>

        <div class="col-md-7">
            <h2 class="fw-bold text-primary">@Model.TenSP</h2>
            <p class="text-muted">Mã SP: #@Model.MaSP | Loại: @Model.LoaiSP</p>

            <div class="fs-3 fw-bold text-danger mb-3">
                @Model.DonGia.ToString("N0") đ
            </div>

            <p class="lead">@Model.MoTaSP</p>

            <div class="d-flex gap-2 mt-4">
                <a asp-controller="GioHang" asp-action="ThemVaoGio" asp-route-maSP="@Model.MaSP" class="btn btn-primary btn-lg rounded-pill px-5">
                    <i class="fas fa-cart-plus me-2"></i> Thêm vào giỏ
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill">
                    Tiếp tục xem hàng
                </a>
            </div>

            <hr class="my-4">

            <div class="small text-muted">
                <p class="mb-1"><i class="fas fa-check-circle text-success me-2"></i>Hàng chính hãng 100%</p>
                <p class="mb-1"><i class="fas fa-shipping-fast text-primary me-2"></i>Giao hàng nhanh toàn quốc</p>
                <p class="mb-0"><i class="fas fa-undo text-warning me-2"></i>Đổi trả trong 7 ngày</p>
            </div>
        </div>
    </div>
</div>