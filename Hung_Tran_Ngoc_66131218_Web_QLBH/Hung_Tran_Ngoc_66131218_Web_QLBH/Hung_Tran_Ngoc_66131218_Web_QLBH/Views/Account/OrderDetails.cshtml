@model List<Hung_Tran_Ngoc_66131218_Web_QLBH.Models.CTBH>

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";

    // Lấy thông tin đơn hàng từ ViewBag truyền sang
    var donHang = ViewBag.DonHang as Hung_Tran_Ngoc_66131218_Web_QLBH.Models.DonBanHang;

    // Tính tổng tiền
    decimal tongTien = 0;
    if (Model != null && Model.Any())
    {
        // Vì bây giờ ThanhTien đã lấy được từ DB, bạn có thể sum trực tiếp
        tongTien = Model.Sum(x => x.ThanhTien);
    }
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary mb-0">
            <i class="fas fa-file-invoice-dollar me-2"></i>CHI TIẾT ĐƠN HÀNG #@donHang.MaDBH
        </h3>
        <a asp-action="MyOrders" class="btn btn-outline-secondary rounded-pill">
            <i class="fas fa-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-4">
                    <p class="mb-1 text-muted small">Ngày đặt hàng</p>
                    <p class="fw-bold mb-0">@donHang.NgayBan.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="col-md-4 text-center">
                    <p class="mb-1 text-muted small">Trạng thái</p>
                    <span class="badge bg-success px-3 py-2">Đã ghi nhận</span>
                </div>
                <div class="col-md-4 text-md-end">
                    <p class="mb-1 text-muted small">Tổng trị giá</p>
                    <h3 class="text-danger fw-bold m-0">@tongTien.ToString("N0") đ</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h6 class="m-0 fw-bold text-primary"><i class="fas fa-list me-2"></i>Danh sách sản phẩm</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0 table-hover">
                    <thead class="bg-light text-secondary small">
                        <tr>
                            <th class="ps-4 py-3">Sản phẩm</th>
                            <th class="text-center py-3">Số lượng</th>
                            <th class="text-end py-3">Đơn giá</th>
                            <th class="text-end pe-4 py-3">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(item.AnhSP))
                                        {
                                            <img src="/images/uploads/@item.AnhSP" style="width: 60px; height: 60px; object-fit: contain;" class="rounded border bg-white me-3">
                                        }
                                        else
                                        {
                                            <img src="https://via.placeholder.com/60" class="rounded border me-3">
                                        }
                                        <span class="fw-bold">@item.TenSP</span>
                                    </div>
                                </td>

                                <td class="text-center">
                                    <span class="badge bg-secondary rounded-pill">x @item.SLB</span>
                                </td>

                                <td class="text-end">@item.DGB.ToString("N0") đ</td>

                                <td class="text-end pe-4 fw-bold text-primary">
                                    @item.ThanhTien.ToString("N0") đ
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white text-muted small fst-italic p-3">
            * Cảm ơn bạn đã mua sắm tại Shop Giải Khát.
        </div>
    </div>
</div>