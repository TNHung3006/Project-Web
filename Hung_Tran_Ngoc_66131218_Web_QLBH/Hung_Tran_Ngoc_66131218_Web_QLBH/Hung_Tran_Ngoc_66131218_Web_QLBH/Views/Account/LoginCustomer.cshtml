@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <title>Đăng nhập - Shop Giải Khát</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: linear-gradient(135deg, #71b7e6, #9b59b6); height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { width: 400px; background: white; padding: 40px; border-radius: 10px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); }
    </style>
</head>
<body>
    <div class="login-card">
        <h3 class="text-center text-primary mb-4 fw-bold">ĐĂNG NHẬP</h3>

        <form action="/Account/LoginCustomer" method="post">
            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success">@ViewBag.Success</div>
            }
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">@ViewBag.Error</div>
            }

            <div class="mb-3">
                <label class="form-label fw-bold">Tên đăng nhập</label>
                <input type="text" name="username" class="form-control" required placeholder="Nhập tên đăng nhập" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Mật khẩu</label>
                <input type="password" name="password" class="form-control" required placeholder="Nhập mật khẩu" />
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary fw-bold">ĐĂNG NHẬP</button>
            </div>

            <div class="text-center mt-3">
                <span class="text-muted">Chưa có tài khoản?</span>
                <a href="/Account/Register" class="text-decoration-none fw-bold">Đăng ký mới</a>
            </div>
            <div class="text-center mt-2">
                <a href="/" class="text-secondary small">← Về trang chủ</a>
            </div>
        </form>
    </div>
</body>
</html>