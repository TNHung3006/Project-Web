@model IEnumerable<Hung_Tran_Ngoc_66131218_Web_QLBH.Models.DonBanHang>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
}

<div class="container py-5">
    <h3 class="fw-bold text-primary mb-4"><i class="fas fa-history me-2"></i>LỊCH SỬ ĐƠN HÀNG</h3>

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-primary">
                            <tr>
                                <th class="py-3 ps-4">Mã đơn</th>
                                <th class="py-3">Ngày đặt</th>
                                <th class="py-3">Trạng thái</th>
                                <th class="py-3 text-end pe-4">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">#@item.MaDBH</td>
                                    <td>@item.NgayBan.ToString("dd/MM/yyyy HH:mm")</td>

                                    <td>
                                        <span class="badge bg-info text-dark">Đã ghi nhận</span>
                                    </td>

                                    <td class="text-end pe-4">
                                        <a href="#" class="btn btn-sm btn-outline-primary">
                                            Xem chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <img src="https://cdn-icons-png.flaticon.com/512/2038/2038854.png" style="width: 100px; opacity: 0.5;" class="mb-3">
            <h5 class="text-muted">Bạn chưa có đơn hàng nào!</h5>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-primary mt-3 rounded-pill px-4 fw-bold">
                Mua sắm ngay
            </a>
        </div>
    }
</div>