@model Hung_Tran_Ngoc_66131218_Web_QLBH.Models.NhanVien

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <h1 class="h3 mb-4 text-gray-800 fw-bold">Hồ sơ cá nhân</h1>

    <div class="row">
        <div class="col-xl-4 col-md-5 mb-4">
            <div class="card shadow mb-4">
                <div class="card-body text-center">
                    <img class="img-profile rounded-circle mb-3 shadow-sm"
                         src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png"
                         style="width: 150px; height: 150px; object-fit: cover;">

                    <h4 class="fw-bold text-primary">@Model.HoNV @Model.TenNV</h4>
                    <p class="text-muted mb-1">@@@Model.TenDN</p>

                    <div class="mb-3">
                        @if (Model.MaLNV == 1)
                        {
                            <span class="badge bg-danger">Quản trị viên (Admin)</span>
                        }
                        else if (Model.MaLNV == 2)
                        {
                            <span class="badge bg-success">Nhân viên Bán hàng</span>
                        }
                        else if (Model.MaLNV == 3)
                        {
                            <span class="badge bg-warning text-dark">Thủ kho</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Nhân viên</span>
                        }
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-primary"><i class="fas fa-camera me-1"></i> Đổi ảnh đại diện</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-8 col-md-7 mb-4">
            <div class="card shadow h-100">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between bg-white">
                    <h6 class="m-0 fw-bold text-primary"><i class="fas fa-user-edit me-2"></i>Thông tin chi tiết</h6>
                </div>
                <div class="card-body">
                    <form>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="small mb-1 fw-bold">Họ và tên đệm</label>
                                <input class="form-control" type="text" value="@Model.HoNV" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="small mb-1 fw-bold">Tên</label>
                                <input class="form-control" type="text" value="@Model.TenNV" readonly>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="small mb-1 fw-bold">Giới tính</label>
                                <input class="form-control" type="text" value="@Model.GioiTinh" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="small mb-1 fw-bold">Số điện thoại</label>
                                <input class="form-control" type="text" value="@Model.DienThoai" readonly>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="small mb-1 fw-bold">Email liên hệ</label>
                            <input class="form-control" type="text" value="@Model.Email" readonly>
                        </div>

                        <div class="mb-3">
                            <label class="small mb-1 fw-bold">Địa chỉ</label>
                            <input class="form-control" type="text" value="@Model.DiaChi" readonly>
                        </div>

                        <div class="alert alert-info mt-4">
                            <i class="fas fa-info-circle me-1"></i>
                            Nếu cần cập nhật thông tin cá nhân hoặc đổi mật khẩu, vui lòng liên hệ Quản trị viên hệ thống hoặc sử dụng chức năng Cài đặt.
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>