@model IEnumerable<Hung_Tran_Ngoc_66131218_Web_QLBH.Models.Tinh>

@{
    ViewData["Title"] = "Quản lý Tỉnh thành";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary bg-gradient text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-map-marked-alt me-2"></i>QUẢN LÝ TỈNH / THÀNH PHỐ</h5>
                    <a asp-action="Create" class="btn btn-light btn-sm rounded-pill fw-bold text-primary shadow-sm">
                        <i class="fas fa-plus me-1"></i> Thêm mới
                    </a>
                </div>

                <div class="card-body bg-light">

                    <form asp-action="Index" method="get" class="row justify-content-end mb-3">
                        <div class="col-md-6">
                            <div class="input-group shadow-sm">
                                <input type="text" name="search" value="@ViewData["CurrentFilter"]" class="form-control border-0" placeholder="Tìm tên tỉnh/thành phố..." />
                                <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
                            </div>
                        </div>
                    </form>

                    <div class="table-responsive rounded shadow-sm">
                        <table class="table table-hover align-middle mb-0 bg-white">
                            <thead class="bg-light">
                                <tr class="text-uppercase text-secondary text-xs font-weight-bolder opacity-7">
                                    <th class="ps-4">Mã Tỉnh</th>
                                    <th>Tên Tỉnh / Thành phố</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="fw-bold text-secondary">#@item.MaTinh</span>
                                        </td>

                                        <td>
                                            <span class="fw-bold text-dark fs-6">
                                                <i class="fas fa-city text-info me-2"></i>@item.TenTinh
                                            </span>
                                        </td>

                                        <td class="text-center">
                                            <div class="btn-group shadow-sm">
                                                <a asp-action="Edit" asp-route-id="@item.MaTinh" class="btn btn-sm btn-outline-primary" title="Sửa">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.MaTinh" class="btn btn-sm btn-outline-info" title="Xem">
                                                    <i class="fas fa-info-circle"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.MaTinh" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>