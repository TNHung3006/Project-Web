@model IEnumerable<Hung_Tran_Ngoc_66131218_Web_QLBH.Models.HangSX>

@{
    ViewData["Title"] = "Quản lý Hãng sản xuất";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow border-0">
                <div class="card-header bg-primary bg-gradient text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-industry me-2"></i>QUẢN LÝ HÃNG SẢN XUẤT</h5>
                    <a asp-action="Create" class="btn btn-light btn-sm rounded-pill fw-bold text-primary shadow-sm">
                        <i class="fas fa-plus me-1"></i> Thêm mới
                    </a>
                </div>

                <div class="card-body bg-light">
                    <div class="table-responsive rounded shadow-sm">
                        <table class="table table-hover align-middle mb-0 bg-white">
                            <thead class="bg-light">
                                <tr class="text-uppercase text-secondary text-xs font-weight-bolder opacity-7">
                                    <th class="ps-4">Tên Hãng / Mã số</th>
                                    <th>Quốc Gia</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex flex-column">
                                                <span class="fw-bold text-dark fs-6">@item.TenHSX</span>
                                                <small class="text-muted text-xs">Mã HSX: #@item.MaHSX</small>
                                            </div>
                                        </td>

                                        <td>
                                            <div class="d-flex align-items-center text-secondary fw-bold">
                                                <i class="fas fa-globe-americas text-info me-2"></i>
                                                @item.TenNuoc
                                                <span class="text-muted fw-normal ms-2 text-xs">(@item.MaNuoc)</span>
                                            </div>
                                        </td>

                                        <td class="text-center">
                                            <div class="btn-group shadow-sm">
                                                <a asp-action="Edit" asp-route-id="@item.MaHSX" class="btn btn-sm btn-outline-primary" title="Sửa">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.MaHSX" class="btn btn-sm btn-outline-info" title="Xem">
                                                    <i class="fas fa-info-circle"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.MaHSX" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>