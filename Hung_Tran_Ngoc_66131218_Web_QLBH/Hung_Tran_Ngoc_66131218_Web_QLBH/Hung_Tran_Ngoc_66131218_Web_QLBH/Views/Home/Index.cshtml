@using Hung_Tran_Ngoc_66131218_Web_QLBH.Models
@using Microsoft.AspNetCore.Http
@model List<DonBanHang>

@{
    ViewData["Title"] = "Trang chủ - Dashboard";
    // Lấy quyền từ Session
    int role = Context.Session.GetInt32("MaLNV") ?? 0;
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 fw-bold">Tổng quan hệ thống</h1>
        @if (role == 1) // Chỉ Admin mới thấy nút xuất báo cáo
        {
            <a href="#" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
                <i class="fas fa-download fa-sm text-white-50 me-1"></i> Xuất báo cáo
            </a>
        }
    </div>

    <div class="row g-4 mb-4">

        @if (role == 1 || role == 3)
        {
            <div class="col-xl-3 col-md-6">
                <a asp-controller="SanPhams" asp-action="Index" class="text-decoration-none">
                    <div class="card border-left-primary shadow h-100 py-2 border-0 border-start border-4 border-primary transform-hover">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs fw-bold text-primary text-uppercase mb-1">Sản phẩm trong kho</div>
                                    <div class="h5 mb-0 fw-bold text-gray-800">@ViewBag.SoLuongSanPham</div>
                                </div>
                                <div class="col-auto"><i class="fas fa-box fa-2x text-gray-300 text-primary opacity-50"></i></div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }

        @if (role == 1 || role == 2)
        {
            <div class="col-xl-3 col-md-6">
                <a asp-controller="DonBanHangs" asp-action="Index" class="text-decoration-none">
                    <div class="card border-left-success shadow h-100 py-2 border-0 border-start border-4 border-success transform-hover">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs fw-bold text-success text-uppercase mb-1">Đơn hàng đã bán</div>
                                    <div class="h5 mb-0 fw-bold text-gray-800">@ViewBag.SoLuongDonBan</div>
                                </div>
                                <div class="col-auto"><i class="fas fa-shopping-cart fa-2x text-gray-300 text-success opacity-50"></i></div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }

        @if (role == 1 || role == 2)
        {
            <div class="col-xl-3 col-md-6">
                <a asp-controller="KhachHangs" asp-action="Index" class="text-decoration-none">
                    <div class="card border-left-info shadow h-100 py-2 border-0 border-start border-4 border-info transform-hover">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs fw-bold text-info text-uppercase mb-1">Khách hàng thân thiết</div>
                                    <div class="h5 mb-0 fw-bold text-gray-800">@ViewBag.SoLuongKhachHang</div>
                                </div>
                                <div class="col-auto"><i class="fas fa-users fa-2x text-gray-300 text-info opacity-50"></i></div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }

        @if (role == 1 || role == 3)
        {
            <div class="col-xl-3 col-md-6">
                <a asp-controller="DonMuaHangs" asp-action="Index" class="text-decoration-none">
                    <div class="card border-left-warning shadow h-100 py-2 border-0 border-start border-4 border-warning transform-hover">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs fw-bold text-warning text-uppercase mb-1">Đơn nhập hàng</div>
                                    <div class="h5 mb-0 fw-bold text-gray-800">@ViewBag.SoLuongDonMua</div>
                                </div>
                                <div class="col-auto"><i class="fas fa-truck-loading fa-2x text-gray-300 text-warning opacity-50"></i></div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    <div class="row">
        <div class="col-lg-8 mb-4">
            @if (role == 1) // Nếu là Admin
            {
                <div class="card shadow mb-4 h-100">
                    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between bg-white">
                        <h6 class="m-0 fw-bold text-primary"><i class="fas fa-chart-line me-2"></i>Biểu đồ doanh thu năm nay</h6>
                    </div>
                    <div class="card-body">
                        <div class="chart-area" style="height: 320px; position: relative;">
                            <canvas id="myRevenueChart"></canvas>
                        </div>
                    </div>
                </div>
            }
            else // Nếu là nhân viên thường (Sale, Kho, Bảo vệ...)
            {
                <div class="card shadow mb-4 h-100 border-left-info border-start border-4">
                    <div class="card-body p-5 text-center d-flex flex-column justify-content-center align-items-center">
                        <img src="https://cdn-icons-png.flaticon.com/512/4762/4762311.png" style="width: 100px;" class="mb-3 opacity-75" />
                        <h3 class="text-gray-800 fw-bold">Xin chào, @Context.Session.GetString("HoTen")!</h3>
                        <p class="lead text-muted mb-4">Chúc bạn một ngày làm việc hiệu quả.</p>

                        @if (role == 2)
                        {
                            <p class="text-success fw-bold"><i class="fas fa-tag me-1"></i> Bạn đang truy cập với quyền Bán hàng</p>
                        }
                        @if (role == 3)
                        {
                            <p class="text-warning fw-bold"><i class="fas fa-box me-1"></i> Bạn đang truy cập với quyền Thủ kho</p>
                        }
                        @if (role != 1 && role != 2 && role != 3)
                        {
                            <p class="text-secondary"><i class="fas fa-user-shield me-1"></i> Tài khoản của bạn có quyền hạn chế.</p>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4 mb-4">
            @if (role == 1 || role == 2 || role == 3) // Ví dụ: Cho phép Admin, Sale, Kho xem tin tức đơn hàng
            {
                <div class="card shadow mb-4 h-100">
                    <div class="card-header py-3 bg-white">
                        <h6 class="m-0 fw-bold text-primary"><i class="fas fa-history me-2"></i>Đơn hàng mới nhất</h6>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                        <div>
                                            <div class="fw-bold text-dark">
                                                Đơn bán #@item.MaDBH
                                            </div>
                                            <div class="small text-muted">
                                                <i class="fas fa-user me-1"></i> @item.TenKHFull
                                            </div>
                                            <div class="small text-muted">
                                                <i class="far fa-clock me-1"></i> @item.NgayBan.ToString("dd/MM/yyyy HH:mm")
                                            </div>
                                        </div>
                                        <span class="badge bg-success rounded-pill">Mới</span>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="list-group-item text-center text-muted py-4">
                                    <i class="fas fa-box-open fa-2x mb-2"></i>
                                    <p class="mb-0">Chưa có đơn hàng nào.</p>
                                </li>
                            }
                        </ul>
                    </div>
                    @if (role == 1 || role == 2) // Chỉ Admin và Sale mới có link "Xem tất cả"
                    {
                        <div class="card-footer text-center bg-white">
                            <a asp-controller="DonBanHangs" asp-action="Index" class="small text-decoration-none fw-bold">Xem tất cả đơn hàng &rarr;</a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .transform-hover {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .transform-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
            cursor: pointer;
        }
</style>

@section Scripts {
    @if (role == 1)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            var ctx = document.getElementById("myRevenueChart").getContext('2d');
            var myChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ["T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8", "T9", "T10", "T11", "T12"],
                    datasets: [{
                        label: 'Doanh thu (Triệu VNĐ)',
                        data: [15, 20, 25, 22, 30, 37, 49, 51, 57, 65, 70, 82],
                        backgroundColor: 'rgba(78, 115, 223, 0.1)',
                        borderColor: 'rgba(78, 115, 223, 1)',
                        borderWidth: 2,
                        pointBackgroundColor: 'rgba(78, 115, 223, 1)',
                        pointBorderColor: '#fff',
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    scales: {
                        y: { beginAtZero: true },
                        x: { grid: { display: false } }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        </script>
    }
}