@{
    ViewData["Title"] = "Trang chủ - Dashboard";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800 fw-bold">Tổng quan hệ thống</h1>
        <a href="#" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-download fa-sm text-white-50 me-1"></i> Xuất báo cáo
        </a>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">
            <a asp-controller="SanPhams" asp-action="Index" class="text-decoration-none">
                <div class="card border-left-primary shadow h-100 py-2 border-0 border-start border-4 border-primary transform-hover">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs fw-bold text-primary text-uppercase mb-1">
                                    Sản phẩm trong kho
                                </div>
                                <div class="h5 mb-0 fw-bold text-gray-800">@ViewBag.SoLuongSanPham</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-box fa-2x text-gray-300 text-primary opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6">
            <a asp-controller="DonBanHangs" asp-action="Index" class="text-decoration-none">
                <div class="card border-left-success shadow h-100 py-2 border-0 border-start border-4 border-success transform-hover">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs fw-bold text-success text-uppercase mb-1">
                                    Đơn hàng đã bán
                                </div>
                                <div class="h5 mb-0 fw-bold text-gray-800">@ViewBag.SoLuongDonBan</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-shopping-cart fa-2x text-gray-300 text-success opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6">
            <a asp-controller="KhachHangs" asp-action="Index" class="text-decoration-none">
                <div class="card border-left-info shadow h-100 py-2 border-0 border-start border-4 border-info transform-hover">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs fw-bold text-info text-uppercase mb-1">
                                    Khách hàng thân thiết
                                </div>
                                <div class="h5 mb-0 fw-bold text-gray-800">@ViewBag.SoLuongKhachHang</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-users fa-2x text-gray-300 text-info opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-3 col-md-6">
            <a asp-controller="DonMuaHangs" asp-action="Index" class="text-decoration-none">
                <div class="card border-left-warning shadow h-100 py-2 border-0 border-start border-4 border-warning transform-hover">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs fw-bold text-warning text-uppercase mb-1">
                                    Đơn nhập hàng
                                </div>
                                <div class="h5 mb-0 fw-bold text-gray-800">@ViewBag.SoLuongDonMua</div>
                            </div>
                            <div class="col-auto">
                                <i class="fas fa-truck-loading fa-2x text-gray-300 text-warning opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3 bg-white d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 fw-bold text-primary">Biểu đồ doanh thu (Minh họa)</h6>
                </div>
                <div class="card-body text-center" style="min-height: 300px; display: flex; flex-direction: column; align-items: center; justify-content: center; background-color: #f8f9fc;">
                    <i class="fas fa-chart-area fa-4x mb-3 text-secondary opacity-25"></i>
                    <p class="text-muted">Khu vực này có thể tích hợp biểu đồ Chart.js sau này</p>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3 bg-white">
                    <h6 class="m-0 fw-bold text-primary">Hoạt động gần đây</h6>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush small">
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 border-0">
                            <span><i class="fas fa-plus-circle text-success me-2"></i>Nhập kho lô hàng mới</span>
                            <span class="text-muted">2 phút trước</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 border-0">
                            <span><i class="fas fa-shopping-bag text-primary me-2"></i>Đơn hàng #1023 hoàn tất</span>
                            <span class="text-muted">15 phút trước</span>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 border-0">
                            <span><i class="fas fa-user-plus text-info me-2"></i>Khách hàng mới đăng ký</span>
                            <span class="text-muted">1 giờ trước</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .transform-hover {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .transform-hover:hover {
            transform: translateY(-5px); /* Nhảy lên 1 chút */
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important; /* Đổ bóng đậm hơn */
            cursor: pointer;
        }
</style>