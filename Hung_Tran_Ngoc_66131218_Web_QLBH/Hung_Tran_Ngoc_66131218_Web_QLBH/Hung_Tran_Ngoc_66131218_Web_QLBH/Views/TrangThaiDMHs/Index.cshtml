@model IEnumerable<Hung_Tran_Ngoc_66131218_Web_QLBH.Models.TrangThaiDMH>

@{
    ViewData["Title"] = "Quản lý Trạng thái mua hàng";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary bg-gradient text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-clipboard-list me-2"></i>TRẠNG THÁI ĐƠN MUA HÀNG</h5>
                    <a asp-action="Create" class="btn btn-light btn-sm rounded-pill fw-bold text-primary shadow-sm">
                        <i class="fas fa-plus me-1"></i> Thêm mới
                    </a>
                </div>

                <div class="card-body bg-light">
                    <div class="table-responsive rounded shadow-sm">
                        <table class="table table-hover align-middle mb-0 bg-white">
                            <thead class="bg-light">
                                <tr class="text-uppercase text-secondary text-xs font-weight-bolder opacity-7">
                                    <th class="ps-4">Mã Trạng Thái</th>
                                    <th>Tên Trạng Thái</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="fw-bold text-secondary">#@item.MaTTDMH</span>
                                        </td>

                                        <td>
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-2 fs-6">
                                                @item.TenTTDMH
                                            </span>
                                        </td>

                                        <td class="text-center">
                                            <div class="btn-group shadow-sm">
                                                <a asp-action="Edit" asp-route-id="@item.MaTTDMH" class="btn btn-sm btn-outline-primary" title="Sửa">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.MaTTDMH" class="btn btn-sm btn-outline-info" title="Xem">
                                                    <i class="fas fa-info-circle"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.MaTTDMH" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>