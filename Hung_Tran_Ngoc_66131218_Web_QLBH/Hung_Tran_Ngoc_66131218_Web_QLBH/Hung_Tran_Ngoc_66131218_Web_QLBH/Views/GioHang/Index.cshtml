@model List<Hung_Tran_Ngoc_66131218_Web_QLBH.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
}

<div class="container py-5">
    <h2 class="mb-4 fw-bold text-primary"><i class="fas fa-shopping-cart me-2"></i>GIỎ HÀNG CỦA BẠN</h2>

    @if (Model.Count > 0)
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle mb-0 bg-white">
                <thead class="bg-light">
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="/images/uploads/@item.AnhSP" alt="@item.TenSP"
                                         style="width: 50px; height: 50px; object-fit: cover;" class="rounded me-3 border">
                                    <div>
                                        <p class="fw-bold mb-1">@item.TenSP</p>
                                    </div>
                                </div>
                            </td>
                            <td>@item.DonGia.ToString("N0") đ</td>
                            <td>
                                <input type="number" min="1" value="@item.SoLuong" class="form-control form-control-sm text-center" style="width: 60px;">
                            </td>
                            <td class="fw-bold text-primary">@item.ThanhTien.ToString("N0") đ</td>
                            <td>
                                <a asp-action="XoaKhoiGio" asp-route-maSP="@item.MaSP" class="btn btn-sm btn-outline-danger border-0">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="bg-light fw-bold">
                    <tr>
                        <td colspan="3" class="text-end text-uppercase">Tổng cộng:</td>
                        <td class="text-primary fs-5">@Model.Sum(x => x.ThanhTien).ToString("N0") đ</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-controller="Shop" asp-action="Index" class="btn btn-secondary rounded-pill px-4">
                <i class="fas fa-arrow-left me-2"></i>Tiếp tục mua sắm
            </a>
            <a href="#" class="btn btn-success rounded-pill px-4 fw-bold">
                Thanh toán ngay <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <img src="https://cdn-icons-png.flaticon.com/512/11329/11329060.png" alt="Empty Cart" style="width: 150px; opacity: 0.5;" class="mb-3">
            <h4 class="text-muted">Giỏ hàng của bạn đang trống!</h4>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-primary mt-3 rounded-pill px-4">
                Mua sắm ngay
            </a>
        </div>
    }
</div>