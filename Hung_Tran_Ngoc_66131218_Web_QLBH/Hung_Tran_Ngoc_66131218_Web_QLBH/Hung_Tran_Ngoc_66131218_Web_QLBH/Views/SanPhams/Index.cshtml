@model IEnumerable<Hung_Tran_Ngoc_66131218_Web_QLBH.Models.SanPham>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TenSP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DonGia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AnhSP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MoTaSP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaLSP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LoaiSP)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaDVT)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TenDVT)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaTT)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TenTT)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaHSX)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HangSX)
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.TenSP)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DonGia)
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(item.AnhSP))
                    {
                        <img src="/images/uploads/@item.AnhSP" alt="Ảnh SP" style="width: 100px; height: auto; object-fit: cover; border: 1px solid #ddd;" />
                    }
                    else
                    {
                        <span>No Image</span>
                    }
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MoTaSP)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MaLSP)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LoaiSP)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MaDVT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TenDVT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MaTT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TenTT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MaHSX)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HangSX)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.MaSP" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.MaSP" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.MaSP" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>